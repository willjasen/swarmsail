FROM rust:1.90-slim-bookworm AS builder

WORKDIR /build
COPY Cargo.toml ./
COPY Cargo.lock ./
COPY src ./src
COPY web ./web
RUN cargo build --release --locked

FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 SWARMSAIL_CONTAINER=true
WORKDIR /app
COPY --from=builder /build/target/release/swarmsail /usr/local/bin/swarmsail
COPY manage_headscale.py headscale-config.template.yaml ./

CMD ["sh", "-c", "umask 077; exec swarmsail --host 0.0.0.0 --port 8787 --database /data/swarmsail.db --config /data/instances.json"]
